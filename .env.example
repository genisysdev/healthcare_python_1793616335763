# ============================================================
# Healthcare AI Platform — Environment Configuration Template
# Copy to .env and fill in values before running.
# ============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./healthcare.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/healthcare_db

# ── mTLS / TLS (mTLS Context / Cert Required) ─────────────────
MTLS_ENABLED=true
TLS_CA_CERT=certs/ca.crt
TLS_SERVER_CERT=certs/server.crt
TLS_SERVER_KEY=certs/server.key

# ── PHI Redaction (Scrub PHI Data / Mask PII Utility) ─────────
PHI_REDACTION_ENABLED=true

# ── Audit Logging (Audit Logger / Access Trace) ────────────────
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_STORAGE_BACKEND=file       # file | db | siem

# ── Clinical AI Confidence Gate ────────────────────────────────
# Suggestions below this threshold require physician review
AI_CONFIDENCE_THRESHOLD=0.80

# ── Bias Audit / Demographic Variance ──────────────────────────
# Maximum acceptable F1 variance between demographic groups (5%)
BIAS_MAX_VARIANCE_PCT=0.05

# ── FHIR (HL7 Model Check / Compliance Hook) ───────────────────
FHIR_VERSION=R4
